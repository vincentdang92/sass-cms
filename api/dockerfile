FROM python:3.11-slim

WORKDIR /app

# Install build deps cho sentence-transformers và libmagic cho python-magic
RUN apt-get update && apt-get install -y \
    gcc g++ libmagic1 && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Pre-download multilingual model khi build (không phải lúc runtime)
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('paraphrase-multilingual-MiniLM-L12-v2')"

COPY . .

# Production: gunicorn với 1 worker + --preload để model load 1 lần duy nhất (tiết kiệm ~470MB RAM so với 2 workers)
CMD ["gunicorn", "main:app", \
     "-k", "uvicorn.workers.UvicornWorker", \
     "-w", "1", \
     "--preload", \
     "--bind", "0.0.0.0:8000", \
     "--timeout", "120", \
     "--access-logfile", "-", \
     "--error-logfile", "-"]